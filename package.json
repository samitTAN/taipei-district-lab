{
  "name": "taipei-district-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source civic mapping tool for exploring Taipei City Council districts",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data:prepare": "node scripts/prepare-data.mjs",
    "build": "node scripts/build.mjs",
    "dev": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "start": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "check": "node --check src/app.js && node --check scripts/prepare-data.mjs && node --check scripts/build.mjs && node --check scripts/serve.mjs",
    "test": "node tests/smoke.cjs && node tests/smoke.cjs --api",
    "preview:static": "node scripts/serve.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samitTAN/taipei-district-lab.git"
  },
  "bugs": {
    "url": "https://github.com/samitTAN/taipei-district-lab/issues"
  },
  "homepage": "https://github.com/samitTAN/taipei-district-lab#readme"
}
